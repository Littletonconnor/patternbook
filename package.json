{
  "name": "patternbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:directives": "! grep -rnE '(oxlint|eslint)-disable' src",
    "structure": "node scripts/checkStructure.mts",
    "agents": "node scripts/checkAgentsFiles.mts",
    "spacing": "node scripts/checkSpacing.mts",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:coverage": "type-coverage --strict --at-least 100 --ignore-files '.next/**'",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "test:rules": "vitest run lint",
    "test:count": "node scripts/checkTestCount.mts",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run typegen && npm run lint && npm run lint:directives && npm run typecheck && npm run typecheck:coverage && npm run structure && npm run agents && npm run spacing && npm run test && npm run test:count",
    "new:primitive": "node scripts/newPrimitive.mts",
    "new:lesson": "node scripts/newLesson.mts",
    "new:diagram": "node scripts/newDiagram.mts",
    "new:page": "node scripts/newPage.mts",
    "new:rule": "node scripts/newRule.mts",
    "new:rfc": "node scripts/newRfc.mts",
    "promote": "node scripts/promote.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@stylexjs/stylex": "^0.19.2",
    "@types/mdx": "^2.0.14",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stylexjs/babel-plugin": "^0.19.2",
    "@stylexjs/eslint-plugin": "^0.19.2",
    "@stylexjs/postcss-plugin": "^0.19.2",
    "@stylexjs/unplugin": "0.19.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "5.1.1",
    "fast-check": "4.10.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "playwright": "1.63.0",
    "type-coverage": "2.31.2",
    "typescript": "5.9.3",
    "unplugin": "2.3.11",
    "vitest": "5.1.1",
    "vitest-browser-react": "2.3.0"
  }
}
