{
  "name": "patternbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:directives": "! grep -rnE '(oxlint|eslint)-disable' src",
    "structure": "node scripts/checkStructure.mts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run lint:directives && npm run typecheck && npm run structure",
    "new:primitive": "node scripts/newPrimitive.mts",
    "new:lesson": "node scripts/newLesson.mts",
    "new:diagram": "node scripts/newDiagram.mts",
    "new:page": "node scripts/newPage.mts",
    "new:rule": "node scripts/newRule.mts",
    "new:rfc": "node scripts/newRfc.mts",
    "promote": "node scripts/promote.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@stylexjs/stylex": "^0.19.2",
    "@types/mdx": "^2.0.14",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@stylexjs/babel-plugin": "^0.19.2",
    "@stylexjs/eslint-plugin": "^0.19.2",
    "@stylexjs/postcss-plugin": "^0.19.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "^3.10.1",
    "typescript": "^5"
  }
}
